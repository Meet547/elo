generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Player {
  id          String             @id @default(cuid())
  name        String
  rating      Int                @default(1200)
  /// Glicko-2 rating deviation — how sure the ladder is of this rating
  rd          Float              @default(110)
  /// Glicko-2 volatility — how erratic recent sessions have been
  volatility  Float              @default(0.06)
  /// rated sessions played (drives provisional status and the exposure cap)
  rated       Int                @default(0)
  peak        Int                @default(1200)
  hands       Int                @default(0)
  cashes      Int                @default(0)
  netChips    Int                @default(0)
  biggestPot  Int                @default(0)
  streak      Int                @default(0)
  isSimulated Boolean            @default(false) @map("isRival")
  createdAt   DateTime           @default(now())
  lastSeen    DateTime           @default(now())
  results     Session[]
  matchSeats  MatchParticipant[]
  authSessions AuthSession[]
  identities ExternalIdentity[]
  legacySessionsRevoked Boolean @default(false)
  deletedAt DateTime?
}

model Session {
  id           String   @id @default(cuid())
  playerId     String
  matchId      String?
  match        Match?   @relation(fields: [matchId], references: [id])
  mode         GameMode @default(LEGACY)
  player       Player   @relation(fields: [playerId], references: [id])
  hands        Int
  buyIn        Int      @default(1500)
  finalStack   Int
  net          Int
  place        Int
  seats        Int      @default(6)
  ratingBefore Int
  ratingAfter  Int
  biggestPot   Int      @default(0)
  potsWon      Int      @default(0)
  bestSeenHand String?
  bestSeenScore Int?
  bestWinningHand String?
  bestWinningScore Int?
  bestHand     String?
  exit         String?
  createdAt    DateTime @default(now())

  @@unique([matchId, playerId])
}

model LiveRoom {
  code      String   @id
  revision  Int      @default(0)
  matchId   String?  @unique
  match     Match?   @relation(fields: [matchId], references: [id])
  state     String
  expiresAt DateTime

  @@index([expiresAt])
}

model RankedSeat {
  playerId String   @id
  rating   Int
  joinedAt DateTime
  seenAt   DateTime
  roomCode String?

  @@index([roomCode, rating, joinedAt])
}

enum GameMode {
  LEGACY
  PRACTICE
  PRIVATE
  RANKED
}

enum MatchState {
  QUEUED
  PROPOSED
  READY
  ACTIVE
  SETTLING
  SETTLED
  VOID
  FORFEIT
}

model Match {
  id           String             @id @default(cuid())
  state        MatchState         @default(QUEUED)
  handNumber   Int                @default(0)
  version      Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  startedAt    DateTime?
  finishedAt   DateTime?
  room         LiveRoom?
  participants MatchParticipant[]
  settlement   MatchSettlement?
  history      Session[]
  transitions  MatchTransition[]

  @@index([state, updatedAt])
}

model MatchParticipant {
  matchId        String
  playerId       String
  seat           Int
  ratingSnapshot Json
  match          Match  @relation(fields: [matchId], references: [id])
  player         Player @relation(fields: [playerId], references: [id])

  @@id([matchId, playerId])
  @@unique([matchId, seat])
  @@index([playerId])
}

model MatchSettlement {
  id               String   @id @default(cuid())
  matchId          String   @unique
  match            Match    @relation(fields: [matchId], references: [id])
  algorithmVersion String
  result           Json
  createdAt        DateTime @default(now())
}

model MatchTransition {
  id        String     @id @default(cuid())
  matchId   String
  match     Match      @relation(fields: [matchId], references: [id])
  from      MatchState
  to        MatchState
  createdAt DateTime   @default(now())

  @@index([matchId, createdAt])
}

model AuthSession {
  tokenHash String @id
  playerId String
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([playerId])
  @@index([expiresAt])
}

model ExternalIdentity {
  provider String
  subject String
  playerId String
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  email String
  verifiedAt DateTime @default(now())
  @@id([provider, subject])
  @@unique([playerId, provider])
}

model OAuthAttempt {
  stateHash String @id
  browserHash String
  nonce String
  verifier String
  playerId String?
  expiresAt DateTime
  @@index([expiresAt])
}
