{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/lib/db": [
        "./backend/src/lib/db.ts"
      ],
      "@/lib/session": [
        "./backend/src/lib/session.ts"
      ],
      "@/lib/live-rooms": [
        "./backend/src/lib/live-rooms.ts"
      ],
      "@/lib/ranked-queue": [
        "./backend/src/lib/ranked-queue.ts"
      ],
      "@/lib/rate-limit": [
        "./backend/src/lib/rate-limit.ts"
      ],
      "@/lib/ollama": [
        "./backend/src/lib/ollama.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-vercel/types/**/*.ts",
    ".next-vercel/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "examples",
    "backend/.app"
  ]
}
