# FRONTEND (Vercel). Both values are server-only, never NEXT_PUBLIC.
BACKEND_ORIGIN=http://127.0.0.1:4000
BACKEND_PROXY_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# BACKEND (Render). Do not set these in Vercel.
DATABASE_URL=
DIRECT_DATABASE_URL=
SESSION_SECRET=replace-with-a-different-32-character-random-secret
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b
# House practice cannot submit rated results.

# BACKEND ONLY — optional Google sign-in. Same public frontend origin as above.
# OAuth authorized redirect URI: <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated verified provider emails. Never grant roles by display name.
ADMIN_EMAILS=
